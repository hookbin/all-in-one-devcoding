#!/command/with-contenv bash
set -e
exec 2>&1

LOG_DIR=/config/logs/mongodb
mkdir -p /config/mongo_data "$LOG_DIR"
chown -R abc:abc /config/mongo_data "$LOG_DIR"

echo "Starting MongoDB..."
echo "MongoDB log: $LOG_DIR/mongod.log"

exec s6-setuidgid abc mongod \
    --bind_ip 127.0.0.1 \
    --port 27017 \
    --dbpath /config/mongo_data \
    --logpath "$LOG_DIR/mongod.log" \
    --logappend
